          </div>
          <div class="taux-card">
            <h3>🔧 Technicien</h3>
            <div class="taux-row">
              <label>Coeff. coût employeur</label>
              <input type="number" id="ad-tec-coef" step="0.001" min="1">
              <span class="unit">× brut</span>
            </div>
            <div class="taux-row">
              <label>Charges salariales</label>
              <input type="number" id="ad-tec-sal" step="0.001" min="0" max="1">
              <span class="unit">%</span>
            </div>
          </div>
        </div>
        <div class="taux-row" style="margin-bottom:0">
          <label style="font-size:13px">Minimum conventionnel (€/jour)</label>
          <input type="number" id="ad-mini" step="0.01" min="0" style="width:110px;padding:6px 8px;border:1px solid #D0CCC8;border-radius:5px;font-size:13px;font-weight:700;text-align:right;font-family:'Nunito Sans',sans-serif">
          <span class="unit" style="font-size:12px;color:#9B9B9B">€/j</span>
        </div>
        <p style="font-size:11px;color:#9B9B9B;margin-top:8px">Le coefficient multiplicateur inclut les charges patronales + congés payés. Les charges salariales s'appliquent sur le brut pour calculer le net.</p>
      </div>

      <!-- ── PANEL MÉTIERS ── -->
      <div class="admin-panel" id="apanel-metiers">
        <div class="metier-col-head">
          <span>Intitulé</span>
          <span>Catégorie</span>
          <span>Mini/jour</span>
          <span>Cachet ?</span>
          <span></span>
        </div>
        <div class="metier-list" id="admin-metier-list"></div>
        <button class="btn-add-m" onclick="adminAddMetier()">+ Ajouter un métier</button>
      </div>

      <div class="admin-actions">
        <div class="save-toast" id="save-toast">✓ Enregistré !</div>
        <button class="btn-cancel" onclick="closeAdmin()">Annuler</button>
        <button class="btn-save" onclick="adminSave()">Enregistrer</button>
      </div>

    </div>
  </div>
</div>

<!-- ── BOUTON FEEDBACK FLOTTANT ── -->
<button class="btn-feedback" onclick="openFeedback()">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
  </svg>
  Remarques
</button>

<!-- ── MODAL FEEDBACK ── -->
<div class="fb-overlay" id="fb-overlay" onclick="fbOverlayClick(event)">
  <div class="fb-modal">

    <div class="fb-header">
      <h2>💬 Remarques &amp; améliorations</h2>
      <button class="fb-close" onclick="closeFeedback()">✕</button>
    </div>

    <div class="fb-body">

      <!-- Formulaire -->
      <div id="fb-form">
        <div class="fb-field">
          <label>Type de message</label>
          <div class="fb-type-grid">
            <button class="fb-type-btn on" data-type="Remarque" onclick="setFbType(this)">💡 Remarque</button>
            <button class="fb-type-btn" data-type="Amélioration" onclick="setFbType(this)">🚀 Amélioration</button>
            <button class="fb-type-btn" data-type="Bug" onclick="setFbType(this)">🐛 Bug</button>
            <button class="fb-type-btn" data-type="Question" onclick="setFbType(this)">❓ Question</button>
          </div>
        </div>

        <div class="fb-field">
          <label>Votre nom (optionnel)</label>
          <input type="text" id="fb-nom" placeholder="Prénom Nom ou structure">
        </div>

        <div class="fb-field">
          <label>Message</label>
          <textarea id="fb-msg" placeholder="Décrivez votre remarque ou suggestion..."></textarea>
        </div>

        <div class="fb-actions">
          <button class="fb-cancel" onclick="closeFeedback()">Annuler</button>
          <button class="fb-send" onclick="sendFeedback()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            Envoyer par mail
          </button>
        </div>
      </div>

      <!-- Confirmation -->
      <div class="fb-success" id="fb-success">
        <div class="fb-success-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h3>Message envoyé !</h3>
        <p>Votre messagerie va s'ouvrir avec le mail pré-rempli.<br>Merci pour votre retour 🙏</p>
        <button class="fb-send" onclick="closeFeedback()" style="margin-top:8px">Fermer</button>
      </div>

    </div>
  </div>
</div>
</body>
</html>
