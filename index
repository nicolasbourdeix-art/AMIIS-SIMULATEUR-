// ── Calcul budget ──────────────────────────────────────────────────
function calcBudget(){
  var total  = parseFloat(document.getElementById('bg-total').value)  || 0;
  var prod   = parseFloat(document.getElementById('bg-prod').value)   || 0;
  var diff   = parseFloat(document.getElementById('bg-diff').value)   || 0;
  var admin  = parseFloat(document.getElementById('bg-admin').value)  || 0;
  var autres = parseFloat(document.getElementById('bg-autres').value) || 0;
  var fraisHors     = prod + diff + admin + autres;
  var resteAvantSal = total - fraisHors;

  var resOn = document.getElementById('bg-res').checked;
  var fraisRes = 0, hebT = 0, repasT = 0, transport = 0, nbJoursMax = 0;
  salaries.forEach(function(s){ if(s.nb > nbJoursMax) nbJoursMax = s.nb; });

  if(resOn){
    var heb      = parseFloat(document.getElementById('bg-heb').value)       || 0;
    var nuits    = parseInt(document.getElementById('bg-nuits').value)        || 0;
    var repas    = parseFloat(document.getElementById('bg-repas').value)      || 0;
    transport    = parseFloat(document.getElementById('bg-transport').value)  || 0;
    hebT         = heb * nuits;
    repasT       = repas * nbJoursMax * salaries.length;
    fraisRes     = hebT + repasT + transport;
  }

  var masseSal = 0;
  var warns    = [];
  var salRows  = '';

  salaries.forEach(function(s, idx){
    var m    = METIERS[s.mIdx];
    var t    = TAUX[m.cat];
    var brut = s.brut * s.nb;
    var cout = brut * t.coef;
    var net  = brut * (1 - t.sal);
    if(s.brut < m.mini) warns.push(m.l);
    masseSal += cout;
    var ul = s.mode === 'cachet' ? 'cachet' : 'jour';
    salRows += "<div class='drow sub2'><span>"+(idx+1)+". "+m.l+" · "+s.nb+" "+ul+"(s) · "+f(s.brut)+" €/"+ul+"</span><span></span></div>";
    salRows += "<div class='drow sub2'><span>&nbsp;&nbsp;Brut total</span><span>"+f(brut)+" €</span></div>";
    salRows += "<div class='drow sub2'><span>&nbsp;&nbsp;Charges patronales + CP</span><span>"+f(cout-brut)+" €</span></div>";
    salRows += "<div class='drow sub2'><span>&nbsp;&nbsp;Coût employeur</span><span>"+f(cout)+" €</span></div>";
    salRows += "<div class='drow sub2'><span>&nbsp;&nbsp;Net perçu</span><span>"+f(net)+" €</span></div>";
  });

  var resRows = '';
  if(resOn && fraisRes > 0){
    resRows += "<div class='drow sub2'><span>Hébergement</span><span>"+f(hebT)+" €</span></div>";
    resRows += "<div class='drow sub2'><span>Repas</span><span>"+f(repasT)+" €</span></div>";
    resRows += "<div class='drow sub2'><span>Transport</span><span>"+f(transport)+" €</span></div>";
    resRows += "<div class='drow'><span>Total frais résidence</span><span>"+f(fraisRes)+" €</span></div>";
  }

  var solde      = total - fraisHors - masseSal - fraisRes;
  var pct        = Math.min(100, (fraisHors + masseSal + fraisRes) / total * 100) || 0;
  var warnHtml   = warns.length ? "<div class='warn'>⚠ Minimum conventionnel 3090 (144,24 €/j) non atteint pour : "+warns.join(', ')+".</div>" : '';
  var fillClass  = pct >= 100 ? 'over' : '';
  var soldeLabel = solde < 0 ? 'DÉPASSEMENT' : 'disponible';
  var soldeSign  = solde < 0 ? '- ' : '';
  var sclass     = solde < 0 ? ' red' : '';
  var autresRow  = autres > 0 ? "<div class='drow'><span>Autres frais</span><span>- "+f(autres)+" €</span></div>" : '';
  var resSection = resOn && fraisRes > 0 ? "<hr class='sep'>"+resRows : '';

  var out = '';
  out += warnHtml;
  out += "<div class='card'><div class='card-title'>Récapitulatif financier</div>";
  out += "<div class='kpi'>";
  out += "<div class='k'><div class='kl'>Budget total</div><div class='kv'>"+f(total)+" €</div></div>";
  out += "<div class='k'><div class='kl'>Masse salariale</div><div class='kv'>"+f(masseSal)+" €</div></div>";
  out += "<div class='k'><div class='kl'>Solde disponible</div><div class='kv'>"+f(solde)+" €</div></div>";
  out += "</div>";
  out += "<div class='budget-bar'><div class='budget-fill "+fillClass+"' style='width:"+pct.toFixed(1)+"%'></div></div>";
  out += "<p style='font-size:11px;color:#9B9B9B;margin-bottom:12px'>"+pct.toFixed(1)+" % du budget engagé</p>";
  out += "<div class='dtable'>";
  out += "<div class='drow tot'><span>Budget total</span><span>"+f(total)+" €</span></div>";
  out += "<div class='drow'><span>Frais de production</span><span>- "+f(prod)+" €</span></div>";
  out += "<div class='drow'><span>Frais de diffusion</span><span>- "+f(diff)+" €</span></div>";
  out += "<div class='drow'><span>Frais d'administration</span><span>- "+f(admin)+" €</span></div>";
  out += autresRow;
  out += "<div class='drow tot'><span>Reste pour salaires + résidence</span><span>"+f(resteAvantSal)+" €</span></div>";
  out += "<hr class='sep'>";
  out += "<div class='drow'><span>Coût employeur ("+salaries.length+" salarié"+(salaries.length>1?'s':'')+")</span><span>- "+f(masseSal)+" €</span></div>";
  out += salRows;
  out += resSection;
  out += "<hr class='sep'>";
  out += "<div class='drow tot"+sclass+"'><span>Solde "+soldeLabel+"</span><span>"+soldeSign+f(Math.abs(solde))+" €</span></div>";
  out += "</div></div>";
  document.getElementById('budget-results').innerHTML = out;
}

// ── Calcul coût employeur ──────────────────────────────────────────
function calcCout(){
  var cat    = document.getElementById('ce-cat').value;
  var depuis = document.getElementById('ce-depuis').value;
  var val    = parseFloat(document.getElementById('ce-val').value) || 0;
  var jours  = parseInt(document.getElementById('ce-jours').value) || 1;
  var t      = TAUX[cat];

  document.getElementById('ce-val-label').textContent = depuis === 'brut' ? 'Salaire brut (€)' : 'Salaire net (€)';

  var brut, net, cout;
  if(depuis === 'brut'){
    brut = val * jours;
    net  = brut * (1 - t.sal);
    cout = brut * t.coef;
  } else {
    net  = val * jours;
    brut = net / (1 - t.sal);
    cout = brut * t.coef;
  }
  var brutJ = brut / jours, netJ = net / jours, coutJ = cout / jours;

  var out = '';
  out += "<div class='card'><div class='card-title'>Résultats</div>";
  out += "<div class='kpi'>";
  out += "<div class='k'><div class='kl'>Coût employeur total</div><div class='kv'>"+f(cout)+" €</div><div class='ks'>"+f(coutJ)+" € / jour</div></div>";
  out += "<div class='k'><div class='kl'>Salaire brut</div><div class='kv'>"+f(brut)+" €</div><div class='ks'>"+f(brutJ)+" € / jour</div></div>";
  out += "<div class='k'><div class='kl'>Salaire net</div><div class='kv'>"+f(net)+" €</div><div class='ks'>"+f(netJ)+" € / jour</div></div>";
  out += "</div>";
  out += "<div class='dtable'>";
  out += "<div class='drow tot'><span>Salaire brut ("+jours+" jour"+(jours>1?'s':'')+")</span><span>"+f(brut)+" €</span></div>";
  out += "<div class='drow'><span>Charges patronales + CP (~"+Math.round((t.coef-1)*100)+" %)</span><span>+ "+f(cout-brut)+" €</span></div>";
  out += "<div class='drow tot'><span>Coût employeur</span><span>"+f(cout)+" €</span></div>";
  out += "<hr class='sep'>";
  out += "<div class='drow'><span>Charges salariales (~"+Math.round(t.sal*100)+" %)</span><span>- "+f(brut*t.sal)+" €</span></div>";
  out += "<div class='drow tot'><span>Net perçu</span><span>"+f(net)+" €</span></div>";
  out += "</div></div>";
  document.getElementById('cout-results').innerHTML = out;
}


