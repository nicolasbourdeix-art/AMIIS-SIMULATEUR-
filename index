function onSalChange(id){
  var s = salaries.find(function(x){ return x.id === id; });
  if(!s) return;
  var mi   = parseInt(document.getElementById('sm-'+id).value) || 0;
  var mode = document.getElementById('smo-'+id).value;
  var nb   = parseInt(document.getElementById('snb-'+id).value) || 1;
  var brut = parseFloat(document.getElementById('sb-'+id).value) || 0;
  var m    = METIERS[mi];
  if(!m.cach){
