  TAUX.artiste.coef    = parseFloat(document.getElementById('ad-art-coef').value) || TAUX.artiste.coef;
  TAUX.artiste.sal     = parseFloat(document.getElementById('ad-art-sal').value)  || TAUX.artiste.sal;
  TAUX.technicien.coef = parseFloat(document.getElementById('ad-tec-coef').value) || TAUX.technicien.coef;
  TAUX.technicien.sal  = parseFloat(document.getElementById('ad-tec-sal').value)  || TAUX.technicien.sal;
  var mini             = parseFloat(document.getElementById('ad-mini').value)     || 144.24;

  // Appliquer mini à tous les métiers admin
  adminMetiers.forEach(function(m){ m.mini = m.mini || mini; m.miniC = m.cach ? m.mini : 0; });

  // Sauvegarder dans localStorage
  var data = { taux: TAUX, metiers: adminMetiers, mini: mini };
  try { localStorage.setItem('amiis_admin', JSON.stringify(data)); } catch(e){}

  // Appliquer en live
  METIERS = adminMetiers.map(function(m){ return Object.assign({}, m); });

  // Recalculer et rafraîchir l'UI
  renderSalList();
  calcBudget();
  calcCout();

  // Toast
  var toast = document.getElementById('save-toast');
  toast.classList.add('show');
  setTimeout(function(){ toast.classList.remove('show'); closeAdmin(); }, 1400);
}

// ── Charger depuis localStorage au démarrage ──
(function loadSaved(){
  try {
    var raw = localStorage.getItem('amiis_admin');
    if(!raw) return;
    var data = JSON.parse(raw);
    if(data.taux){
      TAUX.artiste.coef    = data.taux.artiste.coef;
      TAUX.artiste.sal     = data.taux.artiste.sal;
      TAUX.technicien.coef = data.taux.technicien.coef;
