<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simulateur CDDU — AMIIS</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

body{
  font-family:'Nunito Sans',sans-serif;
  font-size:14px;
  background:#F4F4F1;
  color:#3A3A3A;
  min-height:100vh;
}

.app{max-width:700px;margin:0 auto;padding:20px 16px 40px}

/* ── HEADER ── */
.header{
  background:#ffffff;
  color:#3A3A3A;
  padding:16px 20px 16px;
  border-radius:10px;
  margin-bottom:16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  border:1px solid #E2E0DB;
  box-shadow:0 1px 4px rgba(0,0,0,0.06);
  position:relative;
  overflow:hidden;
}
.header::after{
  content:'';
  position:absolute;
  bottom:0;left:0;right:0;
  height:3px;
  background:#E8930A;
  border-radius:0 0 10px 10px;
}
.header-text h1{font-size:17px;font-weight:700;margin-bottom:3px;letter-spacing:-0.01em;color:#3A3A3A}
.header-text p{font-size:11px;color:#9B9B9B;font-weight:400}

/* ── LOGO ANIMÉ ── */
.logo-spin{
  flex-shrink:0;
  width:54px;height:54px;
  animation:spin 8s linear infinite;
  transform-origin:center center;
}
@keyframes spin{
  from{transform:rotate(0deg)}
  to{transform:rotate(360deg)}
}

/* ── TABS ── */
.tabs{display:flex;gap:8px;margin-bottom:16px}
.tab{
  flex:1;padding:9px;
  border:1px solid #D0CCC8;
  border-radius:8px;
  background:#fff;
  cursor:pointer;
  font-size:13px;font-weight:600;
  color:#6B6B6B;
  text-align:center;
  font-family:'Nunito Sans',sans-serif;
  transition:all .15s;
}
.tab.on{background:#E8930A;color:#fff;border-color:#E8930A}
.tab:not(.on):hover{border-color:#E8930A;color:#E8930A}

.panel{display:none}.panel.on{display:block}

/* ── CARDS ── */
.card{
  background:#fff;
  border:1px solid #E2E0DB;
  border-radius:10px;
  padding:14px 16px;
  margin-bottom:12px;
}
.card-title{
  font-size:11px;font-weight:700;
  color:#E8930A;
  text-transform:uppercase;
  letter-spacing:.08em;
  margin-bottom:12px;
}

/* ── ROWS ── */
.row{display:flex;align-items:center;gap:10px;margin-bottom:9px}
.row label{font-size:13px;color:#4A4A4A;min-width:195px;flex-shrink:0;font-weight:600}
.row input,.row select{
  flex:1;padding:7px 10px;
  border:1px solid #D0CCC8;
  border-radius:6px;
  font-size:13px;
  background:#fff;color:#3A3A3A;
  font-family:'Nunito Sans',sans-serif;
  transition:border-color .15s;
}
.row input:focus,.row select:focus{
  outline:none;border-color:#E8930A;
}
.row .hint{font-size:11px;color:#9B9B9B;white-space:nowrap}

/* ── TOGGLE ── */
.toggle{display:flex;align-items:center;gap:8px;cursor:pointer}
.toggle input{
  width:16px;height:16px;flex-shrink:0;
  accent-color:#E8930A;
  cursor:pointer;
}
.toggle span{font-size:13px;font-weight:600;color:#3A3A3A}
.sub{margin-top:11px;border-top:1px solid #E2E0DB;padding-top:11px}

/* ── KPI ── */
.kpi{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.k{border-radius:8px;padding:10px 12px;background:#FFF4E6}
.k .kl{font-size:11px;color:#C97808;opacity:.85;margin-bottom:3px;font-weight:600}
.k .kv{font-size:17px;font-weight:800;color:#8A5500}
.k .ks{font-size:11px;color:#B8860B;margin-top:2px}

/* ── DETAIL TABLE ── */
.dtable{
  border:1px solid #E2E0DB;
  border-radius:8px;
  font-size:12px;
  overflow:hidden;
  margin-bottom:0;
}
.drow{
  display:flex;justify-content:space-between;
  padding:6px 13px;
  border-bottom:1px solid #F0EDE8;
  color:#5A5A5A;
}
.drow:last-child{border-bottom:none}
.drow.tot{font-weight:700;color:#3A3A3A;background:#F9F7F4}
.drow.sub2{padding-left:24px;font-size:11px;color:#9B9B9B}
.drow.red{color:#B04010}
.sep{border:none;border-top:1px solid #E2E0DB;margin:0}

/* ── WARN ── */
.warn{
  background:#FFF8E1;
  border:1px solid #FFD54F;
  border-radius:8px;
  padding:9px 13px;
  font-size:12px;color:#7B5800;
  margin-bottom:10px;
}

/* ── SAL BLOCK ── */
.sal-block{
  border:1px solid #E2E0DB;
  border-radius:8px;
  padding:12px 14px;
  margin-bottom:10px;
  background:#FAFAF8;
}
.sal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.sal-title{font-size:13px;font-weight:700;color:#E8930A}

.btn-rm{
  background:none;
  border:1px solid #D0CCC8;
  border-radius:6px;
  padding:3px 10px;
  font-size:12px;color:#6B6B6B;
  cursor:pointer;
  font-family:'Nunito Sans',sans-serif;
  transition:all .15s;
}
.btn-rm:hover{border-color:#E8930A;color:#E8930A}

.btn-add{
  width:100%;padding:9px;
  border:1px dashed #D0CCC8;
  border-radius:8px;
  background:transparent;
  color:#6B6B6B;
  font-size:13px;font-weight:600;
  cursor:pointer;
  margin-bottom:12px;
  font-family:'Nunito Sans',sans-serif;
  transition:all .15s;
}
.btn-add:hover{border-color:#E8930A;color:#E8930A}

/* ── BUDGET BAR ── */
.budget-bar{height:10px;border-radius:5px;background:#E2E0DB;overflow:hidden;margin:6px 0 2px}
.budget-fill{height:100%;border-radius:5px;background:#E8930A;transition:width .3s}
.budget-fill.over{background:#B04010}

.note{font-size:11px;color:#AAAAAA;text-align:center;margin-top:14px;line-height:1.7}

select:disabled{background:#F5F5F5;color:#AAAAAA}

@media(max-width:500px){
  .row{flex-direction:column;align-items:flex-start}
  .row label{min-width:unset}
  .kpi{grid-template-columns:1fr 1fr}
}

/* ── BOUTON ADMIN FLOTTANT ── */
.btn-admin{
  position:fixed;
  bottom:22px;right:22px;
  background:#E8930A;
  color:#fff;
  border:none;border-radius:50px;
  padding:10px 18px;
  font-size:13px;font-weight:700;
  font-family:'Nunito Sans',sans-serif;
  cursor:pointer;
  box-shadow:0 4px 14px rgba(232,147,10,0.45);
  display:flex;align-items:center;gap:7px;
  z-index:1000;
  transition:all .2s;
}
.btn-admin:hover{background:#c97808;box-shadow:0 6px 18px rgba(232,147,10,0.55);transform:translateY(-1px)}
.btn-admin svg{width:16px;height:16px;flex-shrink:0}

/* ── OVERLAY ADMIN ── */
.admin-overlay{
  display:none;
  position:fixed;inset:0;
  background:rgba(0,0,0,0.45);
  z-index:2000;
  align-items:flex-start;
  justify-content:center;
  padding:24px 16px;
  overflow-y:auto;
}
.admin-overlay.open{display:flex}

.admin-modal{
  background:#fff;
  border-radius:14px;
  width:100%;max-width:660px;
  box-shadow:0 20px 60px rgba(0,0,0,0.25);
  overflow:hidden;
  margin:auto;
}
.admin-header{
  background:#E8930A;
  color:#fff;
  padding:16px 20px;
  display:flex;align-items:center;justify-content:space-between;
}
.admin-header h2{font-size:16px;font-weight:700;margin:0}
.admin-close{
  background:rgba(255,255,255,0.2);border:none;border-radius:6px;
  color:#fff;font-size:18px;width:30px;height:30px;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  font-family:'Nunito Sans',sans-serif;
  transition:background .15s;
}
.admin-close:hover{background:rgba(255,255,255,0.35)}

.admin-body{padding:20px}

.admin-tabs{display:flex;gap:6px;margin-bottom:18px}
.admin-tab{
  padding:7px 16px;border-radius:7px;border:1px solid #D0CCC8;
  background:#fff;cursor:pointer;font-size:13px;font-weight:600;
  font-family:'Nunito Sans',sans-serif;color:#6B6B6B;
  transition:all .15s;
}
.admin-tab.on{background:#E8930A;color:#fff;border-color:#E8930A}

.admin-panel{display:none}.admin-panel.on{display:block}

/* Taux */
.taux-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.taux-card{border:1px solid #E2E0DB;border-radius:8px;padding:14px}
.taux-card h3{font-size:12px;font-weight:700;color:#E8930A;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
.taux-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px}
.taux-row label{font-size:12px;color:#4A4A4A;font-weight:600;flex:1}
.taux-row input{
  width:90px;padding:5px 8px;border:1px solid #D0CCC8;border-radius:5px;
  font-size:13px;font-weight:700;color:#3A3A3A;text-align:right;
  font-family:'Nunito Sans',sans-serif;
}
.taux-row input:focus{outline:none;border-color:#E8930A}
.taux-row .unit{font-size:11px;color:#9B9B9B;flex-shrink:0}

/* Métiers */
.metier-list{display:flex;flex-direction:column;gap:6px;margin-bottom:12px;max-height:320px;overflow-y:auto}
.metier-item{
  display:grid;grid-template-columns:1fr 100px 80px 70px 32px;
  gap:6px;align-items:center;
  padding:7px 10px;
  border:1px solid #E2E0DB;border-radius:7px;background:#FAFAF8;
  font-size:12px;
}
.metier-item input[type=text],.metier-item select{
  padding:5px 7px;border:1px solid #D0CCC8;border-radius:5px;
  font-size:12px;font-family:'Nunito Sans',sans-serif;
  background:#fff;color:#3A3A3A;width:100%;
}
.metier-item input[type=text]:focus,.metier-item select:focus{outline:none;border-color:#E8930A}
.metier-item input[type=number]{
  padding:5px 7px;border:1px solid #D0CCC8;border-radius:5px;
  font-size:12px;font-family:'Nunito Sans',sans-serif;width:100%;
}
.metier-item input[type=checkbox]{width:15px;height:15px;accent-color:#E8930A;cursor:pointer}
.metier-col-head{
  display:grid;grid-template-columns:1fr 100px 80px 70px 32px;
  gap:6px;padding:0 10px 6px;
  font-size:10px;font-weight:700;color:#9B9B9B;text-transform:uppercase;letter-spacing:.06em;
}
.btn-del-m{
  background:none;border:1px solid #E2E0DB;border-radius:5px;
  width:26px;height:26px;cursor:pointer;color:#9B9B9B;font-size:14px;
  display:flex;align-items:center;justify-content:center;
  transition:all .15s;font-family:'Nunito Sans',sans-serif;
}
.btn-del-m:hover{border-color:#B04010;color:#B04010}

.btn-add-m{
  width:100%;padding:7px;border:1px dashed #D0CCC8;border-radius:7px;
  background:transparent;color:#6B6B6B;font-size:12px;font-weight:600;
  cursor:pointer;font-family:'Nunito Sans',sans-serif;margin-bottom:14px;
  transition:all .15s;
}
.btn-add-m:hover{border-color:#E8930A;color:#E8930A}

/* Boutons save */
.admin-actions{display:flex;gap:8px;justify-content:flex-end;padding-top:12px;border-top:1px solid #E2E0DB}
.btn-save{
  padding:8px 20px;border-radius:7px;border:none;
  background:#E8930A;color:#fff;font-size:13px;font-weight:700;
  font-family:'Nunito Sans',sans-serif;cursor:pointer;
  transition:all .15s;
}
.btn-save:hover{background:#c97808}
.btn-cancel{
  padding:8px 16px;border-radius:7px;border:1px solid #D0CCC8;
  background:#fff;color:#6B6B6B;font-size:13px;font-weight:600;
  font-family:'Nunito Sans',sans-serif;cursor:pointer;
  transition:all .15s;
}
.btn-cancel:hover{border-color:#9B9B9B}

.save-toast{
  display:none;
  background:#2E7D52;color:#fff;
  border-radius:7px;padding:8px 14px;
  font-size:12px;font-weight:600;
  align-items:center;gap:6px;
}
.save-toast.show{display:flex}

/* ── BOUTON FEEDBACK FLOTTANT ── */
.btn-feedback{
  position:fixed;
  bottom:22px;right:110px;
  background:#4A4A4A;
  color:#fff;
  border:none;border-radius:50px;
  padding:10px 18px;
  font-size:13px;font-weight:700;
  font-family:'Nunito Sans',sans-serif;
  cursor:pointer;
  box-shadow:0 4px 14px rgba(74,74,74,0.35);
  display:flex;align-items:center;gap:7px;
  z-index:1000;
  transition:all .2s;
}
.btn-feedback:hover{background:#2e2e2e;box-shadow:0 6px 18px rgba(74,74,74,0.45);transform:translateY(-1px)}
.btn-feedback svg{width:16px;height:16px;flex-shrink:0}

/* ── MODAL FEEDBACK ── */
.fb-overlay{
  display:none;
  position:fixed;inset:0;
  background:rgba(0,0,0,0.45);
  z-index:2000;
  align-items:center;
  justify-content:center;
  padding:24px 16px;
}
.fb-overlay.open{display:flex}

.fb-modal{
  background:#fff;
  border-radius:14px;
  width:100%;max-width:480px;
  box-shadow:0 20px 60px rgba(0,0,0,0.25);
  overflow:hidden;
}
.fb-header{
  background:#4A4A4A;
  color:#fff;
  padding:16px 20px;
  display:flex;align-items:center;justify-content:space-between;
}
.fb-header h2{font-size:16px;font-weight:700;margin:0}
.fb-close{
  background:rgba(255,255,255,0.15);border:none;border-radius:6px;
  color:#fff;font-size:18px;width:30px;height:30px;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  font-family:'Nunito Sans',sans-serif;transition:background .15s;
}
.fb-close:hover{background:rgba(255,255,255,0.3)}

.fb-body{padding:20px}

.fb-field{margin-bottom:14px}
.fb-field label{
  display:block;font-size:12px;font-weight:700;
  color:#4A4A4A;text-transform:uppercase;letter-spacing:.06em;
  margin-bottom:6px;
}
.fb-field input,.fb-field select,.fb-field textarea{
  width:100%;padding:9px 11px;
  border:1px solid #D0CCC8;border-radius:7px;
  font-size:13px;font-family:'Nunito Sans',sans-serif;
  color:#3A3A3A;background:#fff;
  transition:border-color .15s;
  resize:none;
}
.fb-field input:focus,.fb-field select:focus,.fb-field textarea:focus{
  outline:none;border-color:#E8930A;
}
.fb-field textarea{min-height:110px;line-height:1.5}

.fb-type-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fb-type-btn{
  padding:8px;border:1.5px solid #D0CCC8;border-radius:8px;
  background:#fff;cursor:pointer;font-size:12px;font-weight:600;
  font-family:'Nunito Sans',sans-serif;color:#6B6B6B;
  text-align:center;transition:all .15s;
}
.fb-type-btn.on{border-color:#E8930A;background:#FFF4E6;color:#E8930A}

.fb-actions{display:flex;gap:8px;justify-content:flex-end;padding-top:14px;border-top:1px solid #E2E0DB;margin-top:4px}
.fb-send{
  padding:9px 22px;border-radius:7px;border:none;
  background:#E8930A;color:#fff;font-size:13px;font-weight:700;
  font-family:'Nunito Sans',sans-serif;cursor:pointer;
  display:flex;align-items:center;gap:7px;
  transition:all .15s;
}
.fb-send:hover{background:#c97808}
.fb-send svg{width:15px;height:15px}
.fb-cancel{
  padding:9px 16px;border-radius:7px;border:1px solid #D0CCC8;
  background:#fff;color:#6B6B6B;font-size:13px;font-weight:600;
  font-family:'Nunito Sans',sans-serif;cursor:pointer;transition:all .15s;
}
.fb-cancel:hover{border-color:#9B9B9B}

.fb-success{
  display:none;
  flex-direction:column;align-items:center;
  padding:32px 20px;text-align:center;gap:10px;
}
.fb-success.show{display:flex}
.fb-success-icon{
  width:52px;height:52px;border-radius:50%;
  background:#E6F4EC;display:flex;align-items:center;justify-content:center;
}
.fb-success-icon svg{width:26px;height:26px;stroke:#2E7D52}
.fb-success h3{font-size:16px;font-weight:700;color:#3A3A3A;margin:0}
.fb-success p{font-size:13px;color:#9B9B9B;margin:0;line-height:1.5}
</style>
</head>
<body>
<div class="app">

  <!-- HEADER -->
  <div class="header">
    <div class="header-text">
      <h1>Simulateur CDDU — Coût artiste</h1>
      <p>AMIIS · Convention collective CCNEAC 3090 · Intermittent du spectacle</p>
    </div>
    <img class="logo-spin" src="data:image/png;base64," alt="Logo AMIIS" width="62" height="62">
  </div>

  <!-- ONGLETS -->
  <div class="tabs">
    <button class="tab on" id="tab-b" onclick="sw('budget')">Budget projet</button>
    <button class="tab" id="tab-c" onclick="sw('cout')">Coût employeur</button>
  </div>

  <!-- ════ PANEL BUDGET ════ -->
  <div class="panel on" id="panel-budget">

    <div class="card">
      <div class="card-title">Budget global du projet</div>
      <div class="row"><label>Budget total (€)</label><input type="number" id="bg-total" value="20000" min="0" step="100" oninput="calcBudget()"></div>
      <div class="row"><label>Frais de production (€)</label><input type="number" id="bg-prod" value="3000" min="0" step="100" oninput="calcBudget()"></div>
      <div class="row"><label>Frais de diffusion (€)</label><input type="number" id="bg-diff" value="2000" min="0" step="100" oninput="calcBudget()"></div>
      <div class="row"><label>Frais d'administration (€)</label><input type="number" id="bg-admin" value="1000" min="0" step="100" oninput="calcBudget()"></div>
      <div class="row"><label>Autres frais (€)</label><input type="number" id="bg-autres" value="0" min="0" step="100" oninput="calcBudget()"></div>
    </div>

    <div class="card">
      <div class="card-title">Salariés du projet</div>
      <div id="sal-list"></div>
      <button class="btn-add" onclick="addSal()">+ Ajouter un salarié</button>
    </div>

    <div class="card">
      <div class="card-title">Frais de résidence / tournée</div>
      <label class="toggle" for="bg-res">
        <input type="checkbox" id="bg-res" onchange="toggleBgRes()">
        <span>Activer les frais de résidence / tournée</span>
      </label>
      <div id="bg-res-fields" style="display:none" class="sub">
        <div class="row"><label>Hébergement / nuit (€)</label><input type="number" id="bg-heb" value="80" min="0" step="5" oninput="calcBudget()"></div>
        <div class="row"><label>Nombre de nuits</label><input type="number" id="bg-nuits" value="4" min="0" step="1" oninput="calcBudget()"></div>
        <div class="row"><label>Repas / jour / salarié (€)</label><input type="number" id="bg-repas" value="19.40" min="0" step="0.01" oninput="calcBudget()"><span class="hint">Plafond : 19,40 €</span></div>
        <div class="row"><label>Transport forfait total (€)</label><input type="number" id="bg-transport" value="0" min="0" step="10" oninput="calcBudget()"></div>
      </div>
    </div>

    <div id="budget-results"></div>

  </div>

  <!-- ════ PANEL COÛT EMPLOYEUR ════ -->
  <div class="panel" id="panel-cout">

    <div class="card">
      <div class="card-title">Paramètres</div>
      <div class="row">
        <label>Catégorie</label>
        <select id="ce-cat" onchange="calcCout()">
          <option value="artiste">Artiste</option>
          <option value="technicien">Technicien</option>
        </select>
      </div>
      <div class="row">
        <label>Calculer depuis</label>
        <select id="ce-depuis" onchange="calcCout()">
          <option value="brut">Le salaire brut</option>
          <option value="net">Le salaire net</option>
        </select>
      </div>
      <div class="row">
        <label id="ce-val-label">Salaire brut (€)</label>
        <input type="number" id="ce-val" value="1280.63" min="0" step="10" oninput="calcCout()">
      </div>
      <div class="row">
        <label>Nombre de jours</label>
        <input type="number" id="ce-jours" value="1" min="1" step="1" oninput="calcCout()">
      </div>
    </div>

    <div id="cout-results"></div>

  </div>

  <p class="note">Taux Spaiectacle 2024 · Convention CCNEAC 3090 · Minima : 144,24 €/jour<br>Frais de résidence exonérés de charges · Résultats indicatifs</p>

</div>

<script>
// ── Données métiers (remplace la lecture Sheets) ──────────────────
var METIERS = [
  {l:"Artiste interprète",          cat:"artiste",    cach:true,  mini:144.24, miniC:144.24},
  {l:"Musicien·ne",                 cat:"artiste",    cach:true,  mini:144.24, miniC:144.24},
